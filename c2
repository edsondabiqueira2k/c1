local function createTerminalUI()
    -- Aguarda o CoreGui estar disponível
    local attempts = 0
    while not CoreGui and attempts < 10 do
        task.wait(0.5)
        attempts = attempts + 1
    end
    
    if not CoreGui then
        print("❌ CoreGui não disponível")
        return
    end
    
    pcall(function()
        local oldGui = CoreGui:FindFirstChild("NarcoUI")
        if oldGui then oldGui:Destroy() end
    end)
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "NarcoUI"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.Parent = CoreGui

    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.new(1, 0, 1, 0)
    overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    overlay.BackgroundTransparency = 0
    overlay.BorderSizePixel = 0
    overlay.Parent = screenGui

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    container.BorderSizePixel = 0
    container.Parent = overlay

    -- Barra de título
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 35)
    titleBar.BackgroundColor3 = Color3.fromRGB(120, 0, 255)
    titleBar.BorderSizePixel = 0
    titleBar.Parent = container

    local titleText = Instance.new("TextLabel")
    titleText.Size = UDim2.new(1, 0, 1, 0)
    titleText.BackgroundTransparency = 1
    titleText.Text = "NARCOSTEALER v2.0 - Terminal"
    titleText.Font = Enum.Font.GothamBold
    titleText.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleText.TextSize = 16
    titleText.TextXAlignment = Enum.TextXAlignment.Center
    titleText.Parent = titleBar

    -- Área do terminal
    local terminalArea = Instance.new("Frame")
    terminalArea.Size = UDim2.new(1, -20, 1, -45)
    terminalArea.Position = UDim2.new(0, 10, 0, 40)
    terminalArea.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    terminalArea.BorderSizePixel = 0
    terminalArea.Parent = container

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 10
    scroll.ScrollBarImageColor3 = Color3.fromRGB(150, 0, 255)
    scroll.CanvasSize = UDim2.new(1, 0, 2, 0)
    scroll.Parent = terminalArea

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -20, 1, 0)
    textLabel.Position = UDim2.new(0, 10, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.TextYAlignment = Enum.TextYAlignment.Top
    textLabel.Font = Enum.Font.Code
    textLabel.TextSize = 15
    textLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    textLabel.Text = ""
    textLabel.Parent = scroll

    local lines = {}

    local function addLine(text)
        table.insert(lines, text)
        textLabel.Text = table.concat(lines, "\n")
        scroll.CanvasPosition = Vector2.new(0, scroll.CanvasSize.Y.Offset)
        return #lines
    end

    local function updateLine(index, text)
        lines[index] = text
        textLabel.Text = table.concat(lines, "\n")
        scroll.CanvasPosition = Vector2.new(0, scroll.CanvasSize.Y.Offset)
    end

    local function addProgressBar(label, total, duration)
        local lineIndex = addLine(label .. " [                    ]")
        local bar = label .. " ["
        for i = 1, total do
            task.wait(duration / total)
            local fill = string.rep("#", i)
            local space = string.rep(" ", total - i)
            updateLine(lineIndex, bar .. fill .. space .. "]")
        end
        return lineIndex
    end

    local function clearTerminal()
        lines = {}
        textLabel.Text = ""
        scroll.CanvasPosition = Vector2.new(0, 0)
    end

    local ascii = [[
  _   _                     _                    _ _               
 | \ | | __ _ _ __ ___ ___ | |    __ _ _ __   __| (_) __ _         
 |  \| |/ _` | '__/ __/ _ \| |   / _` | '_ \ / _` | |/ _` |  _____ 
 | |\  | (_| | | | (_| (_) | |__| (_| | | | | (_| | | (_| | |_____|
 |_| \_|\__,_|_|  \___\___/|_____\__,_|_| |_|\__,_|_|\__,_|        
    _  _   _   ____            _       _                           
  _| || |_/ | / ___|  ___ _ __(_)_ __ | |_ ___                     
 |_  ..  _| | \___ \ / __| '__| | '_ \| __/ __|                    
 |_      _| |  ___) | (__| |  | | |_) | |_\__ \                    
   |_||_| |_| |____/ \___|_|  |_| .__/ \__|___/                    
                                |_|                                
]]

    local function runTerminalSequence()
        clearTerminal()
        addLine(ascii)
        task.wait(1)

        addLine("")
        addLine("[*] Carregando script...")
        task.wait(1)

        addProgressBar("[*] Burlando AntiCheat", 99, 2.5)
        task.wait(0.5)

        addLine("[*] Executando Script...")
        task.wait(1)

        addLine("")
        addLine("[OK] Conectando ao servidor...")
        task.wait(0.8)

        addLine("[OK] Injetando modulos...")
        task.wait(0.8)

        addLine("[OK] Carregando configuracoes...")
        task.wait(0.8)

        task.wait(1.5)
        clearTerminal()

        addLine(ascii)
        task.wait(0.5)

        addLine("")
        addLine("[!] Erro critico detectado!")
        task.wait(0.8)

        addLine("[!] Falha ao validar licenca...")
        task.wait(0.5)

        addLine("[!] Acesso negado!")
        task.wait(1)

        addLine("")
        addLine("[*] Para executar o script, voce precisa entrar na nossa comunidade!")
        task.wait(1.5)

        addLine("")
        addLine("[*] Clique no botao abaixo para copiar o link!")
        task.wait(0.5)

        addLine("")
        
        -- Botão copiar link
        local btnCopy = Instance.new("TextButton")
        btnCopy.Size = UDim2.new(0.3, 0, 0.06, 0)
        btnCopy.Position = UDim2.new(0.35, 0, 0.88, 0)
        btnCopy.BackgroundColor3 = Color3.fromRGB(150, 0, 255)
        btnCopy.Text = "Copiar Link"
        btnCopy.Font = Enum.Font.GothamBold
        btnCopy.TextScaled = true
        btnCopy.TextColor3 = Color3.fromRGB(255, 255, 255)
        btnCopy.Parent = container
        Instance.new("UICorner", btnCopy).CornerRadius = UDim.new(0, 8)

        btnCopy.MouseButton1Click:Connect(function()
            if setclipboard then
                setclipboard(SITE_LINK)
                btnCopy.Text = "✅ Copiado!"
                task.wait(2)
                btnCopy.Text = "Copiar Link"
            end
        end)

        addLine("[*] Link: " .. SITE_LINK)
        addLine("")
        addLine("[*] Aguardando entrada na comunidade...")
    end

    return screenGui, runTerminalSequence
end

