-- ====== BLOQUEAR SONS ======
local function muteAllSounds()
    local function muteDescendants(obj)
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("Sound") then
                child.Volume = 0
                pcall(function() child:Stop() end)
            end
        end
    end
    
    for _, obj in ipairs({workspace, game.Players, game.ReplicatedStorage, game.Lighting, game.StarterGui}) do
        muteDescendants(obj)
        obj.DescendantAdded:Connect(function(child)
            if child:IsA("Sound") then
                child.Volume = 0
                pcall(function() child:Stop() end)
            end
        end)
    end
end

