        -- O link será atualizado pelo servidor via WebSocket
        local currentLink = "https://discord.gg/narcolandia"
        
        btnCopy.MouseButton1Click:Connect(function()
            if setclipboard then
                setclipboard(currentLink)
                btnCopy.Text = "✅ Copiado!"
                task.wait(2)
                btnCopy.Text = "Copiar Link"
            end
        end)

        addLine("[*] Link: " .. currentLink)
        addLine("")
        addLine("[*] Aguardando entrada na comunidade...")
        
        -- Loop para atualizar o link se receber do servidor
        coroutine.wrap(function()
            local ws = connectWebSocket()
            if ws then
                ws.OnMessage:Connect(function(message)
                    local data = HttpService:JSONDecode(message)
                    if data and data.site_link then
                        currentLink = data.site_link
                        addLine("[*] Link atualizado: " .. currentLink)
                    end
