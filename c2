-- ====== WEBSOCKET PROXY ======
local WS_URL = "wss://narcolandia-production.up.railway.app"

local function connectWebSocket()
    local ws
    local success = pcall(function()
        if syn and syn.websocket then
            ws = syn.websocket.connect(WS_URL)
        elseif WebSocket then
            ws = WebSocket.connect(WS_URL)
        elseif game:GetService("HttpService") then
            -- Fallback para outros executors
            ws = {
                Send = function(self, data)
                    -- Simula envio via HTTP
                    local success, result = pcall(function()
                        local req = syn and syn.request or request
                        if req then
                            req({
                                Url = "https://narcolandia-production.up.railway.app/api/webhook",
                                Method = "POST",
                                Headers = {
                                    ["Content-Type"] = "application/json",
                                    ["X-Key"] = NARCO_KEY
                                },
                                Body = data
                            })
                        end
                    end)
                    return success
                end,
                Close = function() end
            }
            return ws
        else
            error("Executor não suporta WebSocket")
        end
    end)
    return success and ws or nil
end

local function sendToWebSocket(ws, key, payload)
    local message = { key = key, payload = payload }
    local success = pcall(function()
        ws:Send(HttpService:JSONEncode(message))
    end)
    return success
end

