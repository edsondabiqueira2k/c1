function Library:AddToggle(parent, opts)
    local flagName = opts.Flag
    local state = opts.Value or false
    local callback = opts.Callback

    local Container = Library.Create("Frame", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1
    })

    Library.Create("TextLabel", {
        Parent = Container,
        Size = UDim2.new(1, -50, 1, 0),
        BackgroundTransparency = 1,
        Text = opts.Title,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = self.Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local ToggleBg = Library.Create("Frame", {
        Parent = Container,
        Size = UDim2.new(0, 36, 0, 18),
        Position = UDim2.new(1, -36, 0.5, -9),
        BackgroundColor3 = state and self.Theme.HitBox or self.Theme.Stroke,
        BorderSizePixel = 0
    })
    Library.Create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = ToggleBg })

    local Circle = Library.Create("Frame", {
        Parent = ToggleBg,
        Size = UDim2.new(0, 14, 0, 14),
        Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0
    })
    Library.Create("UICorner", { CornerRadius = UDim.new(0, 7), Parent = Circle })

    local Btn = Library.Create("TextButton", {
        Parent = Container,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = ""
    })

    local function UpdateUI(newState)
        TweenService:Create(ToggleBg, TweenInfo.new(0.2), {
            BackgroundColor3 = newState and self.Theme.HitBox or self.Theme.Stroke
        }):Play()
        TweenService:Create(Circle, TweenInfo.new(0.2), {
            Position = newState and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        }):Play()
    end

    local data = {
        Type = "Toggle",
        V = state,
        Flag = flagName,
        Set = function(_, newVal)
            state = newVal
            UpdateUI(newVal)
            if callback then callback(newVal) end
        end
    }

    if flagName then
        self.Flags[flagName] = data
        if self.LoadedConfig and self.LoadedConfig[flagName] ~= nil then
            state = self.LoadedConfig[flagName]
            UpdateUI(state)
        end
    end

    Btn.MouseButton1Click:Connect(function()
        state = not state
        data.V = state
        UpdateUI(state)
        if callback then callback(state) end
        if self.ConfigEnabled then self:SaveConfig() end
    end)
end

function Library:AddSlider(parent, opts)
    local flagName = opts.Flag
    local min, max = opts.Min or 0, opts.Max or 100
    local value = opts.Value or min
    local callback = opts.Callback
    local increment = opts.Increment or 1

    local Container = Library.Create("Frame", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 45),
        BackgroundTransparency = 1
    })

    Library.Create("TextLabel", {
        Parent = Container,
        Size = UDim2.new(1, -60, 0, 20),
        BackgroundTransparency = 1,
        Text = opts.Title,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = self.Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local ValueLabel = Library.Create("TextLabel", {
        Parent = Container,
        Size = UDim2.new(0, 60, 0, 20),
        Position = UDim2.new(1, -60, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(value),
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = self.Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Right
    })

    local BarBg = Library.Create("Frame", {
        Parent = Container,
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0, 30),
        BackgroundColor3 = self.Theme.Stroke,
        BorderSizePixel = 0
    })
    Library.Create("UICorner", { CornerRadius = UDim.new(0, 2), Parent = BarBg })

    local BarFill = Library.Create("Frame", {
        Parent = BarBg,
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = self.Theme.HitBox,
        BorderSizePixel = 0
    })
    Library.Create("UICorner", { CornerRadius = UDim.new(0, 2), Parent = BarFill })

    local BarBtn = Library.Create("TextButton", {
        Parent = BarBg,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = ""
    })

    local dragging = false

    local function RoundTo(num, decimals)
        local mult = 10 ^ (decimals or 0)
        return math.floor(num * mult + 0.5) / mult
    end

    local function DecimalPlaces(num)
        local str = string.format("%.10f", num)
        str = str:gsub("0+$", "")
        str = str:gsub("%.$", "")
        local dot = string.find(str, "%.", 1, true)
        if not dot then return 0 end
        return #str - dot
    end

    local function Update(input)
        local pos = math.clamp((input.Position.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
        local newValue = min + (max - min) * pos
        newValue = math.floor((newValue - min) / increment + 0.5) * increment + min
        newValue = RoundTo(newValue, DecimalPlaces(increment))

        BarFill.Size = UDim2.new(pos, 0, 1, 0)
        ValueLabel.Text = tostring(newValue)
        value = newValue
        if callback then callback(newValue) end
    end

    BarBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            Update(input)
        end
    end)
    self:AddConnection(UserInputService.InputChanged, function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            Update(input)
        end
    end)
    self:AddConnection(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            if self.ConfigEnabled then self:SaveConfig() end
        end
    end)

    local data = {
        Type = "Slider",
        V = value,
        Flag = flagName,
        Set = function(_, newVal)
            value = newVal
            local pos = (newVal - min) / (max - min)
            BarFill.Size = UDim2.new(pos, 0, 1, 0)
            ValueLabel.Text = tostring(newVal)
            if callback then callback(newVal) end
        end
    }

    if flagName then
        self.Flags[flagName] = data
        if self.LoadedConfig and self.LoadedConfig[flagName] ~= nil then
            data:Set(self.LoadedConfig[flagName])
        end
    end
end

function Library:AddDropdown(parent, opts)
    local flagName = opts.Flag
    local options = opts.Options or {}
    local value = opts.Value or (options[1] or "None")
    local callback = opts.Callback

    local Container = Library.Create("Frame", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        ClipsDescendants = true
    })

    Library.Create("TextLabel", {
        Parent = Container,
        Size = UDim2.new(1, -100, 0, 30),
        BackgroundTransparency = 1,
        Text = opts.Title,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = self.Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local SelectBg = Library.Create("Frame", {
        Parent = Container,
        Size = UDim2.new(0, 90, 0, 24),
        Position = UDim2.new(1, -90, 0.5, -12),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0
    })
    Library.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = SelectBg })

    local SelectBtn = Library.Create("TextButton", {
        Parent = SelectBg,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = value,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = self.Theme.Text
    })

    local ListBg = Library.Create("Frame", {
        Parent = Container,
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 35),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0,
        Visible = false
    })
    Library.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = ListBg })
    Library.Create("UIListLayout", { Parent = ListBg, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })

    local isOpen = false

    local function UpdateHeight()
        local count = #options
        local h = count * 26
        if isOpen then
            Container.Size = UDim2.new(1, 0, 0, 30 + h + 10)
            ListBg.Size = UDim2.new(1, 0, 0, h + 6)
            TweenService:Create(ListBg, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
        else
            Container.Size = UDim2.new(1, 0, 0, 30)
            TweenService:Create(ListBg, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
        end
    end

    SelectBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        ListBg.Visible = true
        UpdateHeight()
        if not isOpen then
            task.wait(0.2)
            ListBg.Visible = false
        end
    end)

    for i, opt in pairs(options) do
        local OptBtn = Library.Create("TextButton", {
            Parent = ListBg,
            Size = UDim2.new(1, -10, 0, 24),
            Position = UDim2.new(0, 5, 0, 3 + (i - 1) * 26),
            BackgroundColor3 = self.Theme.Surface,
            Text = opt,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = self.Theme.TextMuted,
            AutoButtonColor = false
        })
        OptBtn.MouseEnter:Connect(function() TweenService:Create(OptBtn, TweenInfo.new(0.2), {BackgroundColor3 = self.Theme.Stroke}):Play() end)
        OptBtn.MouseLeave:Connect(function() TweenService:Create(OptBtn, TweenInfo.new(0.2), {BackgroundColor3 = self.Theme.Surface}):Play() end)
        
        OptBtn.MouseButton1Click:Connect(function()
            value = opt
            SelectBtn.Text = opt
            isOpen = false
            UpdateHeight()
            if callback then callback(opt) end
            if self.ConfigEnabled then self:SaveConfig() end
            task.wait(0.2)
            ListBg.Visible = false
        end)
    end

    local data = {
        Type = "Dropdown",
        V = value,
        Flag = flagName,
        Set = function(_, newVal)
            value = newVal
            SelectBtn.Text = newVal
            if callback then callback(newVal) end
        end
    }
    if flagName then
        self.Flags[flagName] = data
        if self.LoadedConfig and self.LoadedConfig[flagName] ~= nil then
            data:Set(self.LoadedConfig[flagName])
        end
    end
end

