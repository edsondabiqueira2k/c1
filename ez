function Library:CreateTab(name)
    local TabBtn = Library.Create("TextButton", {
        Parent = self.TabList,
        Size = UDim2.new(1, -20, 0, 32),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundColor3 = self.Theme.Surface,
        Text = name,
        Font = Enum.Font.Gotham,
        TextSize = 14,
        TextColor3 = self.Theme.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false
    })
    Library.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = TabBtn })

    local Page = Library.Create("ScrollingFrame", {
        Parent = self.Pages,
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Color3.fromRGB(60, 60, 70),
        Visible = false,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y
    })
    Library.Create("UIListLayout", { Parent = Page, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
    Library.Create("UIPadding", { Parent = Page, PaddingRight = UDim.new(0, 5), PaddingBottom = UDim.new(0, 10) })

    self.Tabs[name] = { Button = TabBtn, Page = Page }

    TabBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(self.Tabs) do
            v.Button.BackgroundColor3 = self.Theme.Surface
            v.Button.TextColor3 = self.Theme.TextMuted
            v.Page.Visible = false
        end
        TabBtn.BackgroundColor3 = self.Theme.Stroke
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Page.Visible = true
        self.ActiveTab = name
    end)

    if not self.ActiveTab then
        TabBtn.BackgroundColor3 = self.Theme.Stroke
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Page.Visible = true
        self.ActiveTab = name
    end

    return Page
end

