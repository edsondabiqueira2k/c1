            HeaderAccent.AnchorPoint = Vector2.new(0, 0.5)
            HeaderAccent.BackgroundColor3 = Theme.Accent
            HeaderAccent.BorderSizePixel = 0
            HeaderAccent.Parent = Header
            Round(HeaderAccent, 2)

            local ElementOrder = 0

            local function NextOrder()
                ElementOrder += 1
                return ElementOrder
            end

            -- ============ LABEL ============
            function Section:AddLabel(text)
                local Label = TextLabel(SectionFrame, text, {
                    Size = UDim2.new(1, 0, 0, 16),
                    LayoutOrder = NextOrder(),
                    TextColor3 = Theme.TextDim,
                    TextSize = 12,
                })
                return Label
            end

            -- ============ TOGGLE ============
            function Section:AddToggle(text, default, callback)
                local Toggle = { Value = default or false, Callback = callback }
                ElementOrder += 1

                local Frame = Instance.new("TextButton")
                Frame.Name = text
                Frame.Size = UDim2.new(1, 0, 0, 32)
                Frame.BackgroundColor3 = Theme.Element
                Frame.Text = ""
                Frame.AutoButtonColor = false
                Frame.LayoutOrder = ElementOrder
                Frame.Parent = SectionFrame
                Round(Frame, 5)

                local LabelEl = TextLabel(Frame, text, {
                    Size = UDim2.new(1, -60, 1, 0),
                    Position = UDim2.fromOffset(10, 0),
                })

                -- Trilho do switch
                local Switch = Instance.new("Frame")
                Switch.Size = UDim2.fromOffset(38, 20)
                Switch.Position = UDim2.new(1, -48, 0.5, 0)
                Switch.AnchorPoint = Vector2.new(0, 0.5)
                Switch.BackgroundColor3 = Theme.Background
                Switch.BorderSizePixel = 0
                Switch.Parent = Frame
                Round(Switch, 10)
                Stroke(Switch, Theme.Stroke, 1, 0)

                -- Bolinha
                local Knob = Instance.new("Frame")
                Knob.Size = UDim2.fromOffset(14, 14)
                Knob.Position = UDim2.new(0, 3, 0.5, 0)
                Knob.AnchorPoint = Vector2.new(0, 0)
                Knob.BackgroundColor3 = Theme.TextDim
                Knob.BorderSizePixel = 0
                Knob.Parent = Switch
                Round(Knob, 7)

                function Toggle:Set(value, silent)
                    Toggle.Value = value
                    local tweenSpeed = 0.2
                    if value then
                        Tween(Knob, { Position = UDim2.new(1, -17, 0.5, 0), BackgroundColor3 = Theme.Accent }, tweenSpeed)
                        Tween(Switch, { BackgroundColor3 = Theme.AccentDark }, tweenSpeed)
                        Tween(LabelEl, { TextColor3 = Theme.Text }, tweenSpeed)
                    else
                        Tween(Knob, { Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Theme.TextDim }, tweenSpeed)
                        Tween(Switch, { BackgroundColor3 = Theme.Background }, tweenSpeed)
                        Tween(LabelEl, { TextColor3 = Theme.Text }, tweenSpeed)
                    end
                    if not silent and Toggle.Callback then
                        Toggle.Callback(value)
                    end
                end

                function Toggle:OnChange(cb)
                    Toggle.Callback = cb
                end

                Frame.MouseButton1Click:Connect(function()
                    Toggle:Set(not Toggle.Value)
                end)

                Frame.MouseEnter:Connect(function()
                    Tween(Frame, { BackgroundColor3 = Theme.ElementHover }, 0.15)
                end)
                Frame.MouseLeave:Connect(function()
                    Tween(Frame, { BackgroundColor3 = Theme.Element }, 0.15)
                end)

                Toggle:Set(Toggle.Value, true)
                return Toggle
            end

            -- ============ SLIDER ============
            function Section:AddSlider(text, minValue, maxValue, defaultValue, stepSize, callback)
                stepSize = stepSize or 1
                local Slider = {
                    Value = defaultValue or minValue,
                    Min = minValue,
                    Max = maxValue,
                    Step = stepSize,
                    Callback = callback,
                }
                ElementOrder += 1

                local Frame = Instance.new("Frame")
                Frame.Name = text
                Frame.Size = UDim2.new(1, 0, 0, 44)
                Frame.BackgroundColor3 = Theme.Element
                Frame.BorderSizePixel = 0
                Frame.LayoutOrder = ElementOrder
                Frame.Parent = SectionFrame
                Round(Frame, 5)

                local SliderLabel = TextLabel(Frame, text, {
                    Size = UDim2.new(1, -80, 0, 32),
                    Position = UDim2.fromOffset(10, 0),
                })

                -- Valor à direita
                local ValueLabel = TextLabel(Frame, tostring(Slider.Value), {
                    Size = UDim2.new(0, 60, 0, 32),
                    Position = UDim2.new(1, -70, 0, 0),
                    TextXAlignment = Enum.TextXAlignment.Right,
                    TextColor3 = Theme.Accent,
                    Font = ez.Config.FontBold,
                })

                -- Trilho
                local Track = Instance.new("TextButton")
                Track.Name = "Track"
                Track.Size = UDim2.new(1, -20, 0, 6)
                Track.Position = UDim2.new(0, 10, 1, -12)
                Track.BackgroundColor3 = Theme.Background
                Track.Text = ""
                Track.AutoButtonColor = false
                Track.Parent = Frame
                Round(Track, 3)
                Stroke(Track, Theme.Stroke, 1, 0)

                local Fill = Instance.new("Frame")
                Fill.Size = UDim2.new(0, 0, 1, 0)
                Fill.BackgroundColor3 = Theme.Accent
                Fill.BorderSizePixel = 0
                Fill.Parent = Track
                Round(Fill, 3)

                local function Update(value)
                    value = math.clamp(value, minValue, maxValue)
                    value = math.floor(value / stepSize + 0.5) * stepSize
                    Slider.Value = value
                    local alpha = (value - minValue) / (maxValue - minValue)
                    Fill.Size = UDim2.new(alpha, 0, 1, 0)
                    ValueLabel.Text = tostring(value)
                    if Slider.Callback then
                        Slider.Callback(value)
                    end
                end

                local dragging = false

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                    end
                end)

                Track.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if dragging
                    and (input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch) then
                        local rel = math.clamp(
                            (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X,
                            0, 1
                        )
                        Update(minValue + (maxValue - minValue) * rel)
                    end
                end)

                function Slider:Set(value, silent)
                    value = math.clamp(value, minValue, maxValue)
                    local alpha = (value - minValue) / (maxValue - minValue)
                    Fill.Size = UDim2.new(alpha, 0, 1, 0)
                    ValueLabel.Text = tostring(value)
                    Slider.Value = value
                    if not silent and Slider.Callback then
                        Slider.Callback(value)
                    end
                end

                Slider:Set(defaultValue or minValue, true)
                return Slider
            end

            -- ============ DROPDOWN ============
            function Section:AddDropdown(text, options, default, callback, multiSelect)
                local Dropdown = {
                    Options = options or {},
                    Selected = multiSelect and {} or (default or (options and options[1] or nil)),
                    Multi = multiSelect or false,
                    Callback = callback,
                    Open = false,
                }
                ElementOrder += 1

                local Frame = Instance.new("Frame")
                Frame.Name = text
                Frame.Size = UDim2.new(1, 0, 0, 32)
                Frame.BackgroundColor3 = Theme.Element
                Frame.BorderSizePixel = 0
                Frame.LayoutOrder = ElementOrder
                Frame.Parent = SectionFrame
                Round(Frame, 5)

                local LabelEl = TextLabel(Frame, text, {
                    Size = UDim2.new(1, -20, 0, 32),
                    Position = UDim2.fromOffset(10, 0),
                })

                local Arrow = TextLabel(Frame, "▼", {
                    Size = UDim2.new(0, 20, 0, 32),
                    Position = UDim2.new(1, -26, 0, 0),
                    TextSize = 10,
                    TextColor3 = Theme.TextDim,
                })

                local ValueButton = Instance.new("TextButton")
                ValueButton.Size = UDim2.new(1, -16, 0, 28)
                ValueButton.Position = UDim2.new(0, 8, 0, 34)
                ValueButton.BackgroundColor3 = Theme.Background
                ValueButton.Text = ""
                ValueButton.AutoButtonColor = false
                ValueButton.Visible = false
                ValueButton.ZIndex = 5
                ValueButton.Parent = Frame
                Round(ValueButton, 4)
                Stroke(ValueButton, Theme.Stroke, 1, 0)

                local ValueText = TextLabel(ValueButton, Dropdown.Multi and "..." or tostring(Dropdown.Selected), {
                    Size = UDim2.new(1, -16, 1, 0),
                    Position = UDim2.fromOffset(8, 0),
                    TextColor3 = Theme.Accent,
                })
                ValueText.ZIndex = 6

                local ListHolder = Instance.new("ScrollingFrame")
                ListHolder.Size = UDim2.new(1, -16, 0, math.min(#Dropdown.Options, 5) * 26 + 4)
                ListHolder.Position = UDim2.new(0, 8, 0, 66)
                ListHolder.BackgroundColor3 = Theme.Background
                ListHolder.BorderSizePixel = 0
                ListHolder.ScrollBarThickness = 2
                ListHolder.ScrollBarImageColor3 = Theme.Accent
                ListHolder.Visible = false
                ListHolder.ZIndex = 5
                ListHolder.CanvasSize = UDim2.new(0, 0, 0, 0)
                ListHolder.AutomaticCanvasSize = Enum.AutomaticSize.Y
                ListHolder.Parent = Frame
                Round(ListHolder, 4)
                Stroke(ListHolder, Theme.Stroke, 1, 0)

                local ListLayout = Instance.new("UIListLayout")
                ListLayout.Padding = UDim.new(0, 2)
                ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
                ListLayout.Parent = ListHolder

                local ListPadding = Padding(ListHolder, 2)

                local function RefreshValueText()
                    if Dropdown.Multi then
                        local count = 0
                        for _ in pairs(Dropdown.Selected) do count += 1 end
                        ValueText.Text = count .. " selecionado(s)"
                    else
                        ValueText.Text = tostring(Dropdown.Selected)
                    end
                end

                local function FireCallback()
                    if Dropdown.Callback then
                        Dropdown.Callback(Dropdown.Multi and Dropdown.Selected or Dropdown.Selected)
                    end
                end

                local OptionButtons = {}

                local function SelectOption(option)
                    if Dropdown.Multi then
                        if Dropdown.Selected[option] then
                            Dropdown.Selected[option] = nil
                        else
                            Dropdown.Selected[option] = true
                        end
                        local btn = OptionButtons[option]
                        if btn then
                            Tween(btn, {
                                BackgroundColor3 = Dropdown.Selected[option]
                                    and Theme.AccentDark or Theme.Background
                            }, 0.15)
                        end
                    else
                        Dropdown.Selected = option
                        for opt, btn in pairs(OptionButtons) do
                            Tween(btn, { BackgroundColor3 = Theme.Background }, 0.15)
                        end
                        local btn = OptionButtons[option]
                        if btn then
                            Tween(btn, { BackgroundColor3 = Theme.AccentDark }, 0.15)
                        end
                        Dropdown:Close()
                    end
                    RefreshValueText()
                    FireCallback()
                end

                for i, option in ipairs(Dropdown.Options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Size = UDim2.new(1, 0, 0, 24)
                    OptBtn.BackgroundColor3 = Theme.Background
                    OptBtn.Text = ""
                    OptBtn.AutoButtonColor = false
                    OptBtn.LayoutOrder = i
                    OptBtn.ZIndex = 6
                    OptBtn.Parent = ListHolder
                    Round(OptBtn, 4)

                    local OptText = TextLabel(OptBtn, tostring(option), {
                        Size = UDim2.new(1, -12, 1, 0),
                        Position = UDim2.fromOffset(6, 0),
                        TextSize = 12,
                    })
                    OptText.ZIndex = 7

                    OptBtn.MouseButton1Click:Connect(function()
                        SelectOption(option)
                    end)

                    OptBtn.MouseEnter:Connect(function()
                        Tween(OptBtn, { BackgroundColor3 = Theme.ElementHover }, 0.1)
                    end)
                    OptBtn.MouseLeave:Connect(function()
                        if not (Dropdown.Multi and Dropdown.Selected[option])
                        and not (not Dropdown.Multi and Dropdown.Selected == option) then
                            Tween(OptBtn, { BackgroundColor3 = Theme.Background }, 0.1)
                        end
                    end)

                    OptionButtons[option] = OptBtn

                    -- estado inicial
                    if Dropdown.Multi and Dropdown.Selected[option] then
                        OptBtn.BackgroundColor3 = Theme.AccentDark
                    elseif not Dropdown.Multi and Dropdown.Selected == option then
                        OptBtn.BackgroundColor3 = Theme.AccentDark
                    end
                end

                function Dropdown:Open()
                    Dropdown.Open = true
                    ValueButton.Visible = true
                    ListHolder.Visible = true
                    Frame.Size = UDim2.new(1, 0, 0, 70 + math.min(#Dropdown.Options, 5) * 26)
                    Tween(Arrow, { Rotation = 180 }, 0.2)
                end

                function Dropdown:Close()
                    Dropdown.Open = false
                    ValueButton.Visible = false
                    ListHolder.Visible = false
                    Frame.Size = UDim2.new(1, 0, 0, 32)
                    Tween(Arrow, { Rotation = 0 }, 0.2)
                end

                function Dropdown:Toggle()
                    if Dropdown.Open then
                        Dropdown:Close()
                    else
                        Dropdown:Open()
                    end
                end

                function Dropdown:Set(option, silent)
                    if Dropdown.Multi then
                        Dropdown.Selected = option
                    else
                        Dropdown.Selected = option
                    end
                    RefreshValueText()
                    if not silent then
                        FireCallback()
                    end
                end

                LabelEl.MouseButton1Click:Connect(Dropdown.Toggle)
                -- área clicável do label
                LabelEl.Active = false

                local ClickArea = Instance.new("TextButton")
                ClickArea.Size = UDim2.new(1, 0, 0, 32)
                ClickArea.BackgroundTransparency = 1
                ClickArea.Text = ""
                ClickArea.AutoButtonColor = false
                ClickArea.Parent = Frame
                ClickArea.MouseButton1Click:Connect(Dropdown.Toggle)

                RefreshValueText()
                return Dropdown
            end

            -- ============ KEYBIND ============
            function Section:AddKeybind(text, defaultKey, callback)
                local Keybind = { Key = defaultKey, Listening = false, Callback = callback }
                ElementOrder += 1

                local Frame = Instance.new("TextButton")
                Frame.Name = text
                Frame.Size = UDim2.new(1, 0, 0, 32)
                Frame.BackgroundColor3 = Theme.Element
                Frame.Text = ""
                Frame.AutoButtonColor = false
                Frame.LayoutOrder = ElementOrder
                Frame.Parent = SectionFrame
                Round(Frame, 5)

                local LabelEl = TextLabel(Frame, text, {
                    Size = UDim2.new(1, -110, 1, 0),
                    Position = UDim2.fromOffset(10, 0),
                })

                local KeyButton = Instance.new("TextLabel")
                KeyButton.Size = UDim2.fromOffset(90, 22)
                KeyButton.Position = UDim2.new(1, -98, 0.5, 0)
                KeyButton.AnchorPoint = Vector2.new(0, 0.5)
                KeyButton.BackgroundColor3 = Theme.Background
                KeyButton.Text = defaultKey and defaultKey.Name or "Nenhuma"
                KeyButton.TextColor3 = Theme.Accent
                KeyButton.Font = ez.Config.FontBold
                KeyButton.TextSize = 12
                KeyButton.Parent = Frame
                Round(KeyButton, 4)
                Stroke(KeyButton, Theme.Stroke, 1, 0)

                Frame.MouseButton1Click:Connect(function()
                    if Keybind.Listening then return end
                    Keybind.Listening = true
                    KeyButton.Text = "..."
                    Tween(KeyButton, { BackgroundColor3 = Theme.AccentDark }, 0.15)
                end)

                UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if Keybind.Listening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            Keybind.Key = input.KeyCode
                            KeyButton.Text = input.KeyCode.Name
                            Tween(KeyButton, { BackgroundColor3 = Theme.Background }, 0.15)
                            Keybind.Listening = false
                        end
                    elseif not gameProcessed
                    and input.KeyCode == Keybind.Key
                    and Keybind.Key ~= nil then
                        if Keybind.Callback then
                            Keybind.Callback(Keybind.Key)
                        end
                    end
                end)

                function Keybind:Set(key)
                    Keybind.Key = key
                    KeyButton.Text = key and key.Name or "Nenhuma"
                end

                return Keybind
            end

            -- ============ COLOR PICKER ============
            function Section:AddColorPicker(text, defaultColor, callback)
                local ColorPicker = { Color = defaultColor or Color3.fromRGB(155, 77, 251), Callback = callback }
                ElementOrder += 1

                local Frame = Instance.new("Frame")
                Frame.Name = text
                Frame.Size = UDim2.new(1, 0, 0, 32)
                Frame.BackgroundColor3 = Theme.Element
                Frame.BorderSizePixel = 0
                Frame.LayoutOrder = ElementOrder
                Frame.Parent = SectionFrame
                Round(Frame, 5)

                local LabelEl = TextLabel(Frame, text, {
                    Size = UDim2.new(1, -60, 1, 0),
                    Position = UDim2.fromOffset(10, 0),
                })

                local Swatch = Instance.new("TextButton")
                Swatch.Size = UDim2.fromOffset(36, 20)
                Swatch.Position = UDim2.new(1, -46, 0.5, 0)
                Swatch.AnchorPoint = Vector2.new(0, 0.5)
                Swatch.BackgroundColor3 = ColorPicker.Color
                Swatch.Text = ""
                Swatch.AutoButtonColor = false
                Swatch.Parent = Frame
                Round(Swatch, 4)
                Stroke(Swatch, Theme.Stroke, 1, 0)

                local function UpdateColor()
                    Swatch.BackgroundColor3 = ColorPicker.Color
                    if ColorPicker.Callback then
                        ColorPicker.Callback(ColorPicker.Color)
                    end
                end

                -- Popup simples: hue + brightness via slider vertical
                Swatch.MouseButton1Click:Connect(function()
                    -- ciclo de hue simples (RGB wheel aproximado)
                    local hue, sat, val = ColorPicker.Color:ToHSV()
                    hue = (hue + 0.0833) % 1 -- avança ~30 graus por clique
                    ColorPicker.Color = Color3.fromHSV(hue, sat > 0 and sat or 1, val > 0 and val or 1)
                    UpdateColor()
                end)

                function ColorPicker:Set(color, silent)
                    ColorPicker.Color = color
                    Swatch.BackgroundColor3 = color
                    if not silent and ColorPicker.Callback then
                        ColorPicker.Callback(color)
                    end
                end

                return ColorPicker
            end

            -- ============ BUTTON ============
            function Section:AddButton(text, callback)
                local Button = { Callback = callback }
                ElementOrder += 1

                local Frame = Instance.new("TextButton")
                Frame.Name = text
                Frame.Size = UDim2.new(1, 0, 0, 32)
                Frame.BackgroundColor3 = Theme.Accent
                Frame.Text = ""
                Frame.AutoButtonColor = false
                Frame.LayoutOrder = ElementOrder
                Frame.Parent = SectionFrame
                Round(Frame, 5)

                local BtnLabel = TextLabel(Frame, text, {
                    Size = UDim2.new(1, 0, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    Font = ez.Config.FontBold,
                })

                Frame.MouseEnter:Connect(function()
                    Tween(Frame, { BackgroundColor3 = Theme.AccentDark }, 0.15)
                end)
                Frame.MouseLeave:Connect(function()
                    Tween(Frame, { BackgroundColor3 = Theme.Accent }, 0.15)
                end)

                Frame.MouseButton1Click:Connect(function()
                    Tween(Frame, { BackgroundColor3 = Theme.Background }, 0.08)
                    task.wait(0.08)
                    Tween(Frame, { BackgroundColor3 = Theme.Accent }, 0.15)
                    if Button.Callback then
                        Button.Callback()
                    end
                end)

                function Button:OnClick(cb)
                    Button.Callback = cb
                end

                return Button
            end

            -- ============ TEXTBOX ============
            function Section:AddTextbox(text, placeholder, callback)
                local Textbox = { Value = "", Callback = callback }
                ElementOrder += 1

                local Frame = Instance.new("Frame")
                Frame.Name = text
                Frame.Size = UDim2.new(1, 0, 0, 58)
                Frame.BackgroundColor3 = Theme.Element
                Frame.BorderSizePixel = 0
                Frame.LayoutOrder = ElementOrder
                Frame.Parent = SectionFrame
                Round(Frame, 5)

                local LabelEl = TextLabel(Frame, text, {
                    Size = UDim2.new(1, -20, 0, 24),
                    Position = UDim2.fromOffset(10, 4),
                })

                local Box = Instance.new("TextBox")
                Box.Size = UDim2.new(1, -20, 0, 26)
                Box.Position = UDim2.new(0, 10, 0, 28)
                Box.BackgroundColor3 = Theme.Background
                Box.PlaceholderText = placeholder or "..."
                Box.PlaceholderColor3 = Theme.TextDim
                Box.Text = ""
                Box.TextColor3 = Theme.Text
                Box.Font = ez.Config.Font
                Box.TextSize = 13
                Box.ClearTextOnFocus = false
                Box.Parent = Frame
                Round(Box, 4)
                Stroke(Box, Theme.Stroke, 1, 0)

                Box.FocusLost:Connect(function(enterPressed)
                    Textbox.Value = Box.Text
                    if Textbox.Callback then
                        Textbox.Callback(Box.Text, enterPressed)
                    end
                end)

                function Textbox:Set(value)
                    Box.Text = value
                    Textbox.Value = value
                end

                return Textbox
            end

            Section.Frame = SectionFrame
            return Section
        end

        table.insert(Window.Tabs, Tab)
        -- seleciona a primeira aba automaticamente
        if #Window.Tabs == 1 then
            Tab:Select()
        end

        return Tab
    end

    -- // ------------------------------------------------------------
    -- Notificações
    -- // ------------------------------------------------------------
    local NotificationHolder = Instance.new("Frame")
    NotificationHolder.Name = "Notifications"
    NotificationHolder.AnchorPoint = Vector2.new(1, 0)
    NotificationHolder.Position = UDim2.new(1, -16, 0, 16)
    NotificationHolder.Size = UDim2.fromOffset(260, 400)
    NotificationHolder.BackgroundTransparency = 1
    NotificationHolder.Parent = ScreenGui

    local NotifLayout = Instance.new("UIListLayout")
    NotifLayout.Padding = UDim.new(0, 8)
    NotifLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    NotifLayout.SortOrder = Enum.SortOrder.LayoutOrder
    NotifLayout.Parent = NotificationHolder

    function Window:Notify(title, description, duration)
        duration = duration or 3

        local Notif = Instance.new("Frame")
        Notif.Size = UDim2.new(1, 0, 0, 0)
        Notif.AutomaticSize = Enum.AutomaticSize.Y
        Notif.BackgroundColor3 = Theme.Background
        Notif.BorderSizePixel = 0
        Notif.Parent = NotificationHolder
        Round(Notif, 6)
        Stroke(Notif, Theme.Stroke, 1, 0.3)

        local NotifPadding = Padding(Notif, 10)

        local TitleText = TextLabel(Notif, title, {
            Font = ez.Config.FontBold,
            TextColor3 = Theme.Accent,
        })

        local DescText = TextLabel(Notif, description or "", {
            TextColor3 = Theme.TextDim,
            TextSize = 12,
            TextWrapped = true,
        })

        -- barra de progresso embaixo
        local Bar = Instance.new("Frame")
        Bar.Size = UDim2.new(1, 0, 0, 2)
        Bar.Position = UDim2.new(0, 0, 1, 0)
        Bar.AnchorPoint = Vector2.new(0, 1)
        Bar.BackgroundColor3 = Theme.Accent
        Bar.BorderSizePixel = 0
        Bar.Parent = Notif
        Round(Bar, 1)

        Notif.Size = UDim2.new(1, 0, 0, 0) -- deixa o AutomaticSize agir

        -- animação de entrada
        TweenService:Create(Bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 0, 2)
        }):Play()

        task.delay(duration, function()
            if Notif and Notif.Parent then
                local out = Tween(Notif, { BackgroundTransparency = 1 }, 0.3)
                TweenService:Create(Notif, TweenInfo.new(0.3), { Position = Notif.Position }):Play()
                task.wait(0.35)
                Notif:Destroy()
            end
        end)

        return Notif
    end

    -- Toggle da GUI com tecla (padrão: RightShift)
    do
        local ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift
        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if not gameProcessed and input.KeyCode == ToggleKey then
                if Main.Visible then
                    Main.Visible = false
                    Shadow.Visible = false
                else
                    Main.Visible = true
                    Shadow.Visible = true
                end
            end
        end)
    end

    Window.Theme = Theme
    return Window
end

