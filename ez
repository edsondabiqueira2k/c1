            Window.ActiveTab = Tab
            Tween(TabButton, { BackgroundColor3 = Theme.AccentDark }, 0.2)
            Tween(Indicator, { BackgroundTransparency = 0 }, 0.2)
            if TabIcon then
                Tween(TabIcon, { ImageColor3 = Theme.Accent }, 0.2)
