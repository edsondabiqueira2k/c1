function Library:CreateWindow(config)
    local self = setmetatable({}, Library)
    
    self.WindowData = {
        Title = config.Title or "ez.",
        Subtitle = config.Subtitle or "v1.0",
        Size = config.Size or UDim2.new(0, 680, 0, 480)
    }

    -- ROOT
    self.ScreenGui = self.Create("ScreenGui", {
        Name = "ez_ui",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = CoreGui
    })

    -- MAIN FRAME
    self.Main = self.Create("Frame", {
        Name = "Main",
        Parent = self.ScreenGui,
        Size = self.WindowData.Size,
        Position = UDim2.new(0.5, -self.WindowData.Size.X.Offset / 2, 0.5, -self.WindowData.Size.Y.Offset / 2),
        BackgroundColor3 = self.Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true
    })
    self.Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = self.Main })
    self.Create("UIStroke", { Color = self.Theme.Stroke, Thickness = 1, Parent = self.Main })

    -- TOP BAR
    self.TopBar = self.Create("Frame", {
        Name = "TopBar",
        Parent = self.Main,
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0
    })
    self.Create("Frame", { -- Separator
        Parent = self.Main,
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 0, 40),
        BackgroundColor3 = self.Theme.Stroke,
        BorderSizePixel = 0
    })

    -- TITLE & SUBTITLE
    self.Create("TextLabel", {
        Parent = self.TopBar,
        Size = UDim2.new(0, 100, 1, 0),
        Position = UDim2.new(0, 20, 0, 0),
        BackgroundTransparency = 1,
        Text = self.WindowData.Title,
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextXAlignment = Enum.TextXAlignment.Left
    })
    self.Create("TextLabel", {
        Parent = self.TopBar,
        Size = UDim2.new(0, 100, 1, 0),
        Position = UDim2.new(0, 65, 0, 0),
        BackgroundTransparency = 1,
        Text = self.WindowData.Subtitle,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = self.Theme.TextDark,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    -- CLOSE BTN
    local CloseBtn = self.Create("TextButton", {
        Parent = self.TopBar,
        Size = UDim2.new(0, 40, 1, 0),
        Position = UDim2.new(1, -40, 0, 0),
        BackgroundTransparency = 1,
        Text = "×",
        Font = Enum.Font.Gotham,
        TextSize = 22,
        TextColor3 = self.Theme.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Center
    })
    CloseBtn.MouseEnter:Connect(function() TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 80, 80)}):Play() end)
    CloseBtn.MouseLeave:Connect(function() TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = self.Theme.TextMuted}):Play() end)
    CloseBtn.MouseButton1Click:Connect(function() self.Main.Visible = false end)

    -- DRAG
    local dragging, dragInput, dragStart, startPos
    self.TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    self.TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    self:AddConnection(UserInputService.InputChanged, function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            self.Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- SIDEBAR
    self.Sidebar = self.Create("Frame", {
        Parent = self.Main,
        Size = UDim2.new(0, 160, 1, -40),
        Position = UDim2.new(0, 0, 0, 40),
        BackgroundColor3 = self.Theme.Background,
        BorderSizePixel = 0
    })
    self.Create("Frame", {
        Parent = self.Sidebar,
        Size = UDim2.new(0, 1, 1, -20),
        Position = UDim2.new(1, -1, 0, 10),
        BackgroundColor3 = self.Theme.Stroke,
        BorderSizePixel = 0
    })
    self.TabList = self.Create("Frame", {
        Parent = self.Sidebar,
        Size = UDim2.new(1, 0, 1, -40),
        Position = UDim2.new(0, 0, 0, 10),
        BackgroundTransparency = 1
    })
    self.Create("UIListLayout", { Parent = self.TabList, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder })

    -- PAGES CONTAINER
    self.Pages = self.Create("Frame", {
        Parent = self.Main,
        Size = UDim2.new(1, -160, 1, -40),
        Position = UDim2.new(0, 160, 0, 40),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0
    })

    self.Tabs = {}
    self.ActiveTab = nil
    self.NotifyFunc = function(data) self:CreateNotification(data) end
    
    -- Notification Holder
    self.NotifHolder = self.Create("Frame", {
        Name = "NotifHolder",
        Parent = self.ScreenGui,
        Size = UDim2.new(0, 300, 1, 0),
        Position = UDim2.new(1, -320, 0, 20),
        BackgroundTransparency = 1
    })
    self.Create("UIListLayout", { Parent = self.NotifHolder, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top })

    self:CreateNotification({Title = "ez.", Content = "Loaded successfully.", Duration = 3})
    return self
end

