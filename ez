        TabPage.ScrollBarImageColor3 = Theme.Accent
        TabPage.ScrollBarImageTransparency = 0.3
        TabPage.CanvasSize = UDim2.new(0, 0, 0, 0)
        TabPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
        TabPage.Visible = false
        TabPage.Parent = Content

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Parent = TabPage

        local PagePadding = Padding(TabPage, 4)

        function Tab:Select()
            if Window.ActiveTab == Tab then return end
            if Window.ActiveTab then
                local old = Window.ActiveTab
                Tween(old.Button, { BackgroundColor3 = Theme.SidebarItem }, 0.2)
                Tween(old.Indicator, { BackgroundTransparency = 1 }, 0.2)
                old.Page.Visible = false
                if old.TabIcon then
