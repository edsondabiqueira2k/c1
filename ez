local Library = {}
Library.__index = Library

Library.Theme = {
    Accent = Color3.fromRGB(255, 151, 227),
    HitBox = Color3.fromRGB(255, 151, 227),
    Background = Color3.fromRGB(16, 16, 18),
    Surface = Color3.fromRGB(22, 22, 25),
    Stroke = Color3.fromRGB(35, 35, 40),
    Text = Color3.fromRGB(200, 200, 200),
    TextMuted = Color3.fromRGB(150, 150, 150),
    TextDark = Color3.fromRGB(100, 100, 100)
}

Library.Flags = {}
Library.SettingsFlags = {}
Library.Connections = {}
Library.Connections_Internal = {}

function Library.Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

function Library:AddConnection(signal, callback)
    local conn = signal:Connect(callback)
    table.insert(self.Connections, conn)
    return conn
end

function Library:Notify(data)
    if self.NotifyFunc then
        self.NotifyFunc(data)
    end
end

-- ============================================================================
-- CONFIG SYSTEM
-- ============================================================================
Library.ConfigEnabled = true
Library.ConfigFolder = "ez_configs"
Library.ConfigFile = "default"

function Library:SaveConfig()
    if not self.ConfigEnabled or not writefile then return end
    
    local data = { _version = 1 }
    for flagName, flag in pairs(self.Flags) do
        if flag.Type == "ColorPicker" and flag.Color then
            data[flagName] = { R = math.round(flag.Color.R * 255), G = math.round(flag.Color.G * 255), B = math.round(flag.Color.B * 255) }
        elseif flag.V ~= nil then
            data[flagName] = flag.V
        elseif flag.StarterValue ~= nil then
            data[flagName] = flag.StarterValue
        end
    end
    
    if makefolder and not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
    if writefile then
        pcall(function()
            writefile(self.ConfigFolder .. "/" .. self.ConfigFile .. ".json", HttpService:JSONEncode(data))
        end)
    end
end

function Library:LoadConfig(configData)
    if not configData then return end
    local applied = 0
    for flagName, value in pairs(configData) do
        local flag = self.Flags[flagName]
        if flag then
            if flag.Type == "ColorPicker" and type(value) == "table" then
                flag:Set(Color3.fromRGB(value.R, value.G, value.B), true)
            elseif flag.Set then
                flag:Set(value, true)
            end
            applied += 1
        end
    end
    return applied
end

