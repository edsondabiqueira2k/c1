local function Round(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or ez.Config.CornerRadius)
    c.Parent = parent
    return c
end

local function Stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or ez.Config.Theme.Stroke
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = parent
    return s
end

local function Padding(parent, all)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, all or 6)
    p.PaddingBottom = UDim.new(0, all or 6)
    p.PaddingLeft = UDim.new(0, all or 6)
    p.PaddingRight = UDim.new(0, all or 6)
    p.Parent = parent
    return p
end

local function Tween(obj, props, speed, style)
    local tween = TweenService:Create(
        obj,
        TweenInfo.new(speed or ez.Config.AnimationSpeed, style or Enum.EasingStyle.Quint),
        props
    )
    tween:Play()
    return tween
end

local function TextLabel(parent, text, props)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = props.Size or UDim2.new(1, 0, 0, 18)
    label.Position = props.Position or UDim2.new()
    label.Font = props.Font or ez.Config.Font
    label.Text = text
    label.TextColor3 = props.TextColor3 or ez.Config.Theme.Text
    label.TextSize = props.TextSize or 13
    label.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.RichText = props.RichText or false
    label.Parent = parent
    return label
end

-- Torna um objeto arrastável (mouse ou touch)
local function MakeDraggable(dragHandle, dragTarget)
    local dragging, dragStart, startPos = false, nil, nil

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = dragTarget.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local inputPos = input.Position
            UserInputService.InputChanged:Connect(function(inp)
                if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
                or inp.UserInputType == Enum.UserInputType.Touch) then
                    local delta = Vector2.new(inp.Position.X - dragStart.X, inp.Position.Y - dragStart.Y)
                    dragTarget.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y
                    )
                end
            end)
        end
    end)
end

