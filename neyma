local function getLevel()
    local success, LevelModule = pcall(function()
        return require(game:GetService("ReplicatedStorage").Modules.LevelModule)
    end)
    if not success then return 0 end
    
    local success2, PlayerDataModule = pcall(function()
        return require(game:GetService("ReplicatedStorage").Modules.ProfileData)
    end)
    if not success2 then return 0 end
    
    for i, v in pairs(LevelModule.XPTable) do
        if PlayerDataModule.NewXP < v then
            return i
        end
    end
    return 0
end

